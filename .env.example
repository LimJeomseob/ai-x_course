# ── Supabase (Project Settings > API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# 서버 전용 — Route Handler(app/api/*)에서만 사용. 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── 포털 URL (메일 본문 링크용, 끝에 / 없이) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app

# ── Gmail 발송 (PRD §9.1) ───────────────────────────────────────────────────
# OAuth2(권장) 또는 앱 비밀번호 중 하나만 설정한다. 둘 다 있으면 OAuth2가 우선.
GMAIL_USER=eros4424@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_APP_PASSWORD=

# ── Vercel Cron 보호 (Vercel이 Authorization: Bearer <CRON_SECRET> 헤더로 호출) ──
CRON_SECRET=CHANGE_ME_LONG_RANDOM_STRING
